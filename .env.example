# Demo/development defaults are explicit. Production must use a non-demo auth mode
# and real secrets supplied through a secret manager or deployment environment.
GRAPH_BLIZZ_ENVIRONMENT=development
GRAPH_BLIZZ_AUTH__MODE=demo_owner
GRAPH_BLIZZ_AUTH__DEMO_OWNER_ID=demo-owner
# Host port published by Docker Compose for rag-api.
GRAPH_BLIZZ_API_PORT=8000
# Host ports published by Docker Compose for the MinIO S3 API and web Console.
GRAPH_BLIZZ_MINIO_API_PORT=9000
GRAPH_BLIZZ_MINIO_CONSOLE_PORT=9001
# Host port published by Docker Compose for Qdrant REST API and web UI.
GRAPH_BLIZZ_QDRANT_PORT=6333
# Host ports published by Docker Compose for Neo4j Browser/HTTP and Bolt.
GRAPH_BLIZZ_NEO4J_HTTP_PORT=7474
GRAPH_BLIZZ_NEO4J_BOLT_PORT=7687

GRAPH_BLIZZ_POSTGRES__HOST=localhost
GRAPH_BLIZZ_POSTGRES__PORT=5432
GRAPH_BLIZZ_POSTGRES__DATABASE=graph_blizz
GRAPH_BLIZZ_POSTGRES__USERNAME=graph_blizz
# Generate for local use: openssl rand -hex 32
# GRAPH_BLIZZ_POSTGRES__PASSWORD=<generated-value>

GRAPH_BLIZZ_MINIO__ENDPOINT_URL=http://localhost:9000
GRAPH_BLIZZ_MINIO__BUCKET=graph-blizz
# Generate separate values for local use: openssl rand -hex 32
# GRAPH_BLIZZ_MINIO__ACCESS_KEY=<generated-value>
# GRAPH_BLIZZ_MINIO__SECRET_KEY=<generated-value>

GRAPH_BLIZZ_QDRANT__URL=http://localhost:6333
GRAPH_BLIZZ_QDRANT__TIMEOUT_SECONDS=10
GRAPH_BLIZZ_NEO4J__URI=bolt://localhost:7687
GRAPH_BLIZZ_NEO4J__USERNAME=neo4j
# Generate for local use: openssl rand -hex 32
# GRAPH_BLIZZ_NEO4J__PASSWORD=<generated-value>
GRAPH_BLIZZ_NEO4J__DATABASE=neo4j
GRAPH_BLIZZ_NEO4J__CONNECTION_TIMEOUT_SECONDS=10

GRAPH_BLIZZ_LIGHTRAG__MAX_PARALLEL_INSERT=4
GRAPH_BLIZZ_LIGHTRAG__WORKING_DIR=/tmp/graph-blizz-lightrag
# Endpoint of an already-running external OpenAI-compatible vLLM embedding
# service. Containers reach it on the host via host.docker.internal; the app and
# clients running outside Compose use GRAPH_BLIZZ_EMBEDDING__BASE_URL.
GRAPH_BLIZZ_COMPOSE_EMBEDDING_BASE_URL=http://host.docker.internal:8000/v1
GRAPH_BLIZZ_EMBEDDING__BASE_URL=http://localhost:8000/v1
GRAPH_BLIZZ_EMBEDDING__MODEL=ai-sage/Giga-Embeddings-instruct-480M-0826
# Optional for an authenticated external embedding provider.
# GRAPH_BLIZZ_EMBEDDING__API_KEY=<provider-value>
GRAPH_BLIZZ_EMBEDDING__DIMENSION=1024
GRAPH_BLIZZ_EMBEDDING__TIMEOUT_SECONDS=30
# Set to the live endpoint to opt in to the external embedding integration test.
# GRAPH_BLIZZ_EMBEDDING_LIVE_BASE_URL=http://localhost:8000/v1

# Host endpoint for an Ollama server running qwen3:1.7b.
GRAPH_BLIZZ_EXTERNAL_LLM__BASE_URL=http://localhost:11434/v1
# Endpoint injected into rag-api by Docker Compose. Ollama must listen on an
# address reachable from containers, not only on the host loopback interface.
GRAPH_BLIZZ_COMPOSE_EXTERNAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
GRAPH_BLIZZ_EXTERNAL_LLM__MODEL=qwen3:1.7b
# Optional for Ollama. For an authenticated provider, supply its API key without
# committing the value.
# GRAPH_BLIZZ_EXTERNAL_LLM__API_KEY=<provider-value>
GRAPH_BLIZZ_EXTERNAL_LLM__TIMEOUT_SECONDS=60

GRAPH_BLIZZ_LOGGING__LEVEL=INFO
GRAPH_BLIZZ_LOGGING__FORMAT=json
GRAPH_BLIZZ_LOGGING__SERVICE_NAME=graph-blizz
